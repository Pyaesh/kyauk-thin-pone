{
  "id": "/",
  "name": "ကျောက်သင်ပုန်း · KyaukThinPone",
  "short_name": "KyaukThinPone",
  "description": "Easy 3D CAD for 3D printing, right in your browser",
  "lang": "my",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/vnd.layerling.project+zip": [
          ".lyl"
        ]
      }
    }
  ],
  "orientation": "any",
  "background_color": "#203937",
  "theme_color": "#218877",
  "categories": [
    "graphics",
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "assets/layerling/layerling-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/layerling/layerling-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/layerling/layerling-icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "assets/layerling/layerling-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ]
}
